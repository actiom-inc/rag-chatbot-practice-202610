# 利用する回答生成API: openai または anthropic
LLM_PROVIDER=openai

# 使用するプロバイダーのAPIキーだけ設定してください
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 必要なら契約上利用できるモデルIDに変更してください
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ローカル埋め込みモデルとDB（変更する場合は既存DBを削除して再登録）
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_PATH=.data/chroma
